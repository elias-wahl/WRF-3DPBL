! ---------------------------------------------------------------------------
! Inn Valley / Radfeld, 500 m, ICON-forced -- MYNN reference run
!
! The control for namelist.input.pbl3d.  Everything outside the turbulence
! configuration is byte-identical to that file, INCLUDING hybrid_opt = 0, so
! the two runs share the same vertical coordinate and the difference is
! attributable to the turbulence closure alone.
!
! Differences from namelist.input.pbl3d, and only these:
!   bl_pbl_physics     0    -> 5     (MYNN level 2.5 EDMF)
!   sf_sfclay_physics  1    -> 5     (MYNN surface layer, MYNN's own pairing)
!   tke_budget         0    -> 1     (MYNN TKE budget terms)
!   diff_opt           0    -> 2     (truly-horizontal Smagorinsky mixing)
!   km_opt             1    -> 4     (horizontal Smagorinsky)
!   pbl3d_*                          (all removed)
!   mix_isotropic           = 0      (only meaningful once diff_opt > 0)
!
! Note the surface-layer confound: MYNN PBL is normally run with its own
! surface layer (5), while pbl3d expects sfclayrev (1).  Keeping each scheme in
! its intended pairing is the defensible reference, but it means the pair
! differs in two components.  To remove the confound instead, set
! sf_sfclay_physics = 1 here as well -- WRF permits MYNN with sfclayrev.
! ---------------------------------------------------------------------------

&time_control
 run_days               = 1,
 run_hours              = 0,
 run_minutes            = 0,
 run_seconds            = 0,
 start_year             = 2025,        ! 2025-07-18 00:00 UTC (= 02:00 CEST)
 start_month            = 07,
 start_day              = 18,
 start_hour             = 00,
 start_minute           = 00,
 start_second           = 00,
 end_year               = 2025,        ! 2025-07-19 00:00 UTC
 end_month              = 07,
 end_day                = 19,
 end_hour               = 00,
 end_minute             = 00,
 end_second             = 00,
 interval_seconds       = 3600,        ! ICON forcing is hourly
 input_from_file        = .true.,
 fine_input_stream      = 0,
 history_interval       = 30,
 frames_per_outfile     = 1,
 restart                = .false.,
 restart_interval       = 180,
 io_form_history        = 2,
 io_form_restart        = 2,
 io_form_input          = 2,
 io_form_boundary       = 2,
 io_form_auxinput2      = 2,
 debug_level            = 0,
 auxhist24_outname      = "meanout_d<domain>_<date>.nc"
 auxhist24_interval_m   = 30,
 auxhist24_interval_s   = 0,
 frames_per_auxhist24   = 1,
 io_form_auxhist24      = 2,
 iofields_filename      = "NONE_SPECIFIED",
 /

&domains
 time_step              = 3,
 time_step_fract_num    = 0,
 time_step_fract_den    = 1,
 max_dom                = 1,
 e_we                   = 601,         ! <- synced from geo_em_d01.nc
 e_sn                   = 501,         ! <- synced from geo_em_d01.nc
 e_vert                 = 81,
 auto_levels_opt        = 2,
 dzbot                  = 24.0,
 max_dz                 = 500.0,
 dzstretch_s            = 1.15,
 dzstretch_u            = 1.10,
 num_metgrid_levels     = 0,           ! <- MUST be synced from met_em (0 = not yet set)
 num_metgrid_soil_levels= 8,
 dx                     = 500,         ! <- synced from geo_em_d01.nc
 dy                     = 500,         ! <- synced from geo_em_d01.nc
 grid_id                = 1,
 parent_id              = 0,
 i_parent_start         = 1,
 j_parent_start         = 1,
 feedback               = 0,
 smooth_option          = 0,
 max_ts_locs            = 160,
 max_ts_level           = 80,
 tslist_unstagger_winds = .true.,
 ts_buf_size            = 1,
 interp_theta           = .true.,
 interp_type            = 2,
 extrap_type            = 2,
 t_extrap_type          = 2,
 use_surface            = .true.,
 smooth_cg_topo         = .true.,
 /

&physics
 mp_physics             = 8,
 ra_lw_physics          = 4,
 ra_sw_physics          = 4,
 radt                   = 1,
 sf_sfclay_physics      = 5,           ! MYNN surface layer
 sf_surface_physics     = 4,
 bl_pbl_physics         = 5,           ! MYNN level 2.5 EDMF
 bldt                   = 0,
 cu_physics             = 0,
 isfflx                 = 1,
 ifsnow                 = 1,
 icloud                 = 1,
 surface_input_source   = 3,
 num_soil_layers        = 4,
 num_land_cat           = 33,          ! <- synced from geo_em_d01.nc NUM_LAND_CAT
 sf_urban_physics       = 0,
 slope_rad              = 1,
 topo_shading           = 1,
 tke_budget             = 1,           ! MYNN TKE budget terms in the output
 acc_phy_tend           = 1,
 /

&dynamics
 hybrid_opt             = 0,           ! kept at 0 to match the pbl3d run's vertical coordinate
 w_damping              = 1,
 diff_opt               = 2,           ! truly horizontal mixing
 km_opt                 = 4,           ! horizontal Smagorinsky
 mix_isotropic          = 0,
 diff_6th_opt           = 2,
 diff_6th_factor        = 0.12,
 diff_6th_slopeopt      = 1,
 diff_6th_thresh        = 0.10,
 base_temp              = 290.,
 damp_opt               = 3,
 zdamp                  = 8000.,
 dampcoef               = 0.2,
 non_hydrostatic        = .true.,
 moist_adv_opt          = 1,
 scalar_adv_opt         = 1,
 use_theta_m            = 1,
 use_q_diabatic         = 0,
 zadvect_implicit       = 1,
 m_opt                  = 1,
 epssm                  = 0.7,
 smdiv                  = 0.1,
 emdiv                  = 0.02,
 sfs_opt                = 0,
 use_input_w            = .false.,
 do_avgflx_em           = 1,
 /

&bdy_control
 spec_bdy_width         = 10,
 spec_zone              = 1,
 relax_zone             = 9,
 specified              = .true.,
 nested                 = .false.,
 /

&grib2
 /

&namelist_quilt
 nio_tasks_per_group    = 0,
 nio_groups             = 1,
 /

&diag
 avg_interval           = 1800,
 hesselberg_avg         = .true.,
 output_dry_theta_fluxes= .true.,
 output_t_fluxes        = 1,
 output_q_fluxes        = 1,
 output_u_fluxes        = 1,
 output_v_fluxes        = 1,
 output_w_fluxes        = 1,
 output_tke_moments     = 0,           ! 1: time mean of qke (QKE_MEAN) into the WRFlux stream
 /
